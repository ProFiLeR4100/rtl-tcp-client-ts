{
	"singleQuote": true,
	"semi": true,
	"arrowParens": "always",
	"useTabs": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": ["^node:(.*)$", "^[^./]", "^\\."],
	"importOrderSeparation": false,
	"importOrderSortSpecifiers": true,
	"importOrderParserPlugins": ["typescript"]
}
