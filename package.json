{
  "name": "rtl-tcp-client",
  "version": "1.0.0",
  "description": "TypeScript/Node.js client for the rtl_tcp RTL-SDR (rtl-sdr-blog) server protocol",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=16" },
  "keywords": ["rtl-sdr", "rtl_tcp", "rtl-sdr-blog", "sdr", "software-defined-radio", "rtlsdr"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run test/client.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}